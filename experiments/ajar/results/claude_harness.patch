+    def _http(self, body: dict) -> dict:               # raw transport, raises raw HTTPError/URLError
+        req = urllib.request.Request(_API_URL, data=json.dumps(body).encode(), headers={...}, method="POST")
+        with urllib.request.urlopen(req, timeout=90) as resp:
+            return json.load(resp)
+
+    def _post(self, body: dict) -> dict:               # retries w/ exponential backoff
+        attempts = int(os.environ.get("AXOR_BENCH_RETRIES", "5"))
+        base = float(os.environ.get("AXOR_BENCH_BACKOFF", "2"))
+        self._retries = 0; last = None
+        for i in range(attempts):
+            try:
+                return self._http(body)
+            except Exception as exc:
+                last = exc
+                if not _is_retryable(exc) or i == attempts - 1:
+                    break
+                self._retries += 1
+                time.sleep(base * (2 ** i))             # 2,4,8,16s …
+        raise ApiError(f"anthropic failed after {self._retries + 1} attempt(s): {type(last).__name__}: {last}")
+
+    def _record(self, usage):                          # spend ledger line -> AXOR_BENCH_SPEND_CAP works
+        path = os.environ.get("AXOR_BENCH_SPEND_LOG")
+        if not path: return
+        pin, pout = _PRICE.get(self.model, (0.0, 0.0))
+        cost = usage.get("input_tokens",0)/1e6*pin + usage.get("output_tokens",0)/1e6*pout
+        with open(path, "a") as f:
+            f.write(json.dumps({"model": self.model, "cost": cost,
+                "prompt_tokens": usage.get("input_tokens"), "completion_tokens": usage.get("output_tokens"),
+                "reasoning_tokens": usage.get("output_tokens") if usage.get("thinking") else None}) + "\n")
+
